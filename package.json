    "@fontsource/source-serif-4": "^5.3.0",
    "@mdx-js/mdx": "^3.1.1",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/functions": "^3.9.11",
    "drizzle-orm": "^0.45.3",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
