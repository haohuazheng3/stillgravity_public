# Copy to .env.local and fill in. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_INDEXABLE=0
ADMIN_EMAILS=

# Database (Neon / any Postgres). Pooled for the app, direct for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk (email code only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe
STRIPE_SECRET_KEY=
# Optional: without a webhook, Stripe events are pulled by POST /api/cron/stripe-sync (scheduled)
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BOOK=
STRIPE_DESCRIPTOR_SUFFIX=
CHECKOUT_OPERATOR_NOTE=
# Only for supervised tests: lets a non-production deployment open a live Checkout
ALLOW_LIVE_CHECKOUT_NONPROD=

# Private files (Cloudflare files worker in front of R2)
FILES_BASE_URL=
FILES_SIGNING_SECRET=
FILES_API_TOKEN=

# Mail worker (owner alerts, test inbox)
MAIL_WORKER_URL=
MAIL_WORKER_TOKEN=
INBOX_INGEST_SECRET=
INBOX_READ_TOKEN=

# Operations
CRON_SECRET=
INDEXNOW_KEY=

# Analytics (FlowGlance public site key)
NEXT_PUBLIC_FLOWGLANCE_KEY=
