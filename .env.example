# Copy to .env.local and fill in. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_INDEXABLE=0
ADMIN_EMAILS=

# Database (Neon / any Postgres). Pooled for the app, direct for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk: only the owner's admin sign-in (buyers never sign in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe. STRIPE_SECRET_KEY may be an account key (sk_/rk_) or an organization key (sk_org…);
# with an organization key, STRIPE_CONTEXT names the account to act on (acct_…).
STRIPE_SECRET_KEY=
STRIPE_CONTEXT=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BOOK=
# Optional line under the pay button, only when other brands also sell through the same Stripe account
CHECKOUT_OPERATOR_NOTE=
# Only for supervised tests: lets a non-production deployment open a live Checkout
ALLOW_LIVE_CHECKOUT_NONPROD=

# Book delivery: Resend sending key (domain-scoped) and the secret that signs download links
RESEND_API_KEY=
DOWNLOAD_TOKEN_SECRET=

# Private files (Cloudflare files worker in front of R2)
FILES_BASE_URL=
FILES_SIGNING_SECRET=
FILES_API_TOKEN=

# Mail worker (owner alerts, test inbox)
MAIL_WORKER_URL=
MAIL_WORKER_TOKEN=
INBOX_INGEST_SECRET=
INBOX_READ_TOKEN=

# Operations
CRON_SECRET=
INDEXNOW_KEY=

# Analytics (FlowGlance public site key)
NEXT_PUBLIC_FLOWGLANCE_KEY=
